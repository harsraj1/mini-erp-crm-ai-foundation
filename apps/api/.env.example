NODE_ENV=development
PORT=4000
# Local Docker development only; keep these values and DATABASE_URL in sync.
POSTGRES_USER=mini_erp
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=mini_erp
DATABASE_URL=postgresql://mini_erp:local_dev_password@127.0.0.1:5432/mini_erp?schema=public&connect_timeout=5
CORS_ORIGIN=http://localhost:5173
# Reserved for Phase 1; authentication is not implemented yet.
JWT_SECRET=replace_me
JWT_EXPIRES_IN=8h
