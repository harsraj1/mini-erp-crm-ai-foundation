generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATIONS
  SALES
  WAREHOUSE
  ACCOUNTS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customerFollowUps CustomerFollowUp[]
  stockMovements StockMovement[]
  challansCreated Challan[]
  assignedWorkOrders WorkOrder[] @relation("AssignedWorkOrders")
  createdWorkOrders WorkOrder[] @relation("CreatedWorkOrders")
  operationsTransfers InternalTransfer[]
  operationsOrders CustomerOrder[]
  inventoryEvents InventoryEvent[]
}

model Item {
  id String @id @default(cuid())
  name String
  code String @unique
  category String
  balances InventoryBalance[]
  workOrders WorkOrder[]
}

model Location {
  id String @id @default(cuid())
  name String @unique
  balances InventoryBalance[]
  workOrders WorkOrder[]
  incomingTransfers InternalTransfer[]
}

model InventoryBalance {
  id String @id @default(cuid())
  itemId String
  locationId String
  batch String
  physicalQuantity Int @default(0)
  reservedQuantity Int @default(0)
  item Item @relation(fields:[itemId], references:[id], onDelete:Restrict)
  location Location @relation(fields:[locationId], references:[id], onDelete:Restrict)
  events InventoryEvent[]
  transfers InternalTransfer[]
  orders CustomerOrder[]
  @@unique([itemId, locationId, batch])
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model WorkOrder {
  id String @id @default(cuid())
  requestId String @unique
  itemId String
  locationId String
  requiredQuantity Int
  assignedUserId String
  createdById String
  status WorkOrderStatus @default(ASSIGNED)
  createdAt DateTime @default(now())
  item Item @relation(fields:[itemId], references:[id], onDelete:Restrict)
  location Location @relation(fields:[locationId], references:[id], onDelete:Restrict)
  assignedUser User @relation("AssignedWorkOrders", fields:[assignedUserId], references:[id], onDelete:Restrict)
  createdBy User @relation("CreatedWorkOrders", fields:[createdById], references:[id], onDelete:Restrict)
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
}

model InternalTransfer {
  id String @id @default(cuid())
  requestId String @unique
  sourceBalanceId String
  destinationLocationId String
  quantity Int
  status TransferStatus @default(REQUESTED)
  createdById String
  createdAt DateTime @default(now())
  dispatchedAt DateTime?
  receivedAt DateTime?
  sourceBalance InventoryBalance @relation(fields:[sourceBalanceId], references:[id], onDelete:Restrict)
  destinationLocation Location @relation(fields:[destinationLocationId], references:[id], onDelete:Restrict)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Restrict)
}

model CustomerOrder {
  id String @id @default(cuid())
  requestId String @unique
  customerName String
  balanceId String
  quantity Int
  createdById String
  createdAt DateTime @default(now())
  balance InventoryBalance @relation(fields:[balanceId], references:[id], onDelete:Restrict)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Restrict)
}

model InventoryEvent {
  id String @id @default(cuid())
  requestId String @unique
  balanceId String
  physicalChange Int
  reservedChange Int
  reason String
  createdById String
  createdAt DateTime @default(now())
  balance InventoryBalance @relation(fields:[balanceId], references:[id], onDelete:Restrict)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Restrict)
}

enum MovementType {
  IN
  OUT
}

model Product {
  id String @id @default(cuid())
  productName String
  sku String @unique
  category String
  unitPrice Decimal @db.Decimal(12, 2)
  currentStock Int @default(0)
  minimumStockAlertQuantity Int @default(0)
  warehouseLocation String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stockMovements StockMovement[]
  challanItems ChallanItem[]
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  quantityChanged Int
  movementType MovementType
  reason String
  createdById String
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([productId, createdAt, id])
  @@index([createdById, createdAt])
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}
model Challan {
  id String @id @default(cuid())
  challanNumber String @unique
  customerId String
  status ChallanStatus @default(DRAFT)
  totalQuantity Int
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Restrict)
  items ChallanItem[]
  @@index([status, createdAt, id])
}
model ChallanItem {
  id String @id @default(cuid())
  challanId String
  productId String?
  productNameSnapshot String
  skuSnapshot String
  unitPriceSnapshot Decimal @db.Decimal(12,2)
  quantity Int
  challan Challan @relation(fields:[challanId], references:[id], onDelete:Cascade)
  product Product? @relation(fields:[productId], references:[id], onDelete:SetNull)
  @@index([challanId])
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id           String         @id @default(cuid())
  customerName String
  mobileNumber String
  email        String
  businessName String
  gstNumber    String?
  customerType CustomerType
  address      String
  status       CustomerStatus
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  followUps    CustomerFollowUp[]
  challans Challan[]

  @@index([status, customerType])
  @@index([createdAt, id])
}

model CustomerFollowUp {
  id           String   @id @default(cuid())
  customerId   String
  note         String
  followUpDate DateTime?
  createdById  String
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt, id])
  @@index([createdById])
}
