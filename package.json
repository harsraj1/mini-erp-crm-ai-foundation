{
  "name": "mini-erp-crm", "private": true, "version": "0.0.0",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "db:up": "docker compose --env-file apps/api/.env up -d --wait db",
    "db:stop": "docker compose --env-file apps/api/.env stop db",
    "dev:api": "npm run dev --workspace @mini-erp/api",
    "dev:web": "npm run dev --workspace @mini-erp/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace @mini-erp/api",
    "db:validate": "npm run db:validate --workspace @mini-erp/api",
    "db:check": "npm run db:check --workspace @mini-erp/api"
  }
}
